<Window x:Class="PremiumTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premium Tools v1.0 - Gaming Optimizer"
        Width="1400" Height="820" WindowStartupLocation="CenterScreen"
        Background="#040b14" Foreground="#eaf6ff">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#050d1b" BorderBrush="#19273f" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Separator Background="#203249" Margin="0,0,0,10"/>
                    <TextBlock Text="OS: Windows 11" Foreground="#7d8da2" FontSize="10"/>
                    <TextBlock Text="Premium Tools v1.0" Foreground="#7d8da2" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,25">
                        <Border Width="36" Height="36" Background="#0b1b34" BorderBrush="#1ee9ff" BorderThickness="2">
                            <TextBlock Text="⚡" Foreground="#1ee9ff" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0"><TextBlock Text="PREMIUM TOOLS" FontWeight="Bold" FontSize="15"/><TextBlock Text="VERSION v1.0" Foreground="#5cb7d4" FontSize="9"/></StackPanel>
                    </StackPanel>
                    <Border Background="#0d1626" BorderBrush="#1e3556" BorderThickness="1" Padding="12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="👤" FontSize="22"/><StackPanel Margin="10,0,0,0"><TextBlock Text="Dev" FontWeight="Bold"/><TextBlock Text="● Active" Foreground="#44e7b5" FontSize="11"/></StackPanel></StackPanel>
                    </Border>
                    <Button Content="◉   1. DASHBOARD" Height="42" Margin="0,0,0,6" Background="#0c1c30" Foreground="#1ee9ff" BorderBrush="#17314e" Click="BtnDashboard_Click"/>
                    <Button Content="🧹   2. CLEANING" Height="42" Margin="0,0,0,6" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnCleaning_Click"/>
                    <Button Content="⚙   3. OPTIMIZE" Height="42" Margin="0,0,0,6" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnOptimize_Click"/>
                    <Button Content="🎮   4. FIVEM BOOSTER" Height="42" Margin="0,0,0,6" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnBoost_Click"/>
                    <Button Content="🔧   5. QUICK TOOLS" Height="42" Margin="0,0,0,6" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnQuickTools_Click"/>
                    <Button Content="ℹ   6. SYSTEM INFO" Height="42" Margin="0,0,0,6" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnSystemInfo_Click"/>
                    <Button Content="🔒   7. LICENSE" Height="42" Background="Transparent" Foreground="#dfeaf8" BorderBrush="#1a2a3d" Click="BtnSecurity_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#050d1b" BorderBrush="#19273d" BorderThickness="0,0,0,1" Padding="18,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="ADMINISTRATOR" Width="110" Height="32" Background="#0a2133" Foreground="#76e7ff" BorderBrush="#1ee9ff" Click="BtnAdmin_Click"/>
                        <Button Content="HWID" Width="75" Height="32" Margin="8,0,0,0" Background="#0a2133" Foreground="#76e7ff" BorderBrush="#1ee9ff" Click="BtnHwid_Click"/>
                        <Button Content="GAMING PROFILE" Width="130" Height="32" Margin="8,0,0,0" Background="#0a2133" Foreground="#76e7ff" BorderBrush="#1ee9ff" Click="BtnProfile_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔑 KEY: godego" Foreground="#63e0ff" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="⚙" Width="32" Height="32" Click="BtnSettings_Click"/>
                        <Button Content="−" Width="32" Height="32" Margin="6,0,0,0" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="32" Height="32" Margin="6,0,0,0" Click="BtnClose_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22">
                    <Border Background="#101d2a" BorderBrush="#1b2d48" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="◐  System Live Stats Realtime" FontSize="25" FontWeight="Bold"/><TextBlock Text="Gaming performance monitoring for FiveM" Foreground="#8ea0b0" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#101d2a" BorderBrush="#1b2d48" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="◴  CPU USAGE" FontWeight="Bold" FontSize="16"/><ProgressBar x:Name="ProgressCpu" Value="27" Maximum="100" Height="12" Foreground="#1ee9ff" Margin="0,14,0,0"/><TextBlock x:Name="LabelCpu" Text="Processor Active Load" Foreground="#8ea0b0" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="#101d2a" BorderBrush="#1b2d48" BorderThickness="1" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="◫  RAM USAGE" FontWeight="Bold" FontSize="16"/><ProgressBar x:Name="ProgressRam" Value="43" Maximum="100" Height="12" Foreground="#ff5ac8" Margin="0,14,0,0"/><TextBlock x:Name="LabelRam" Text="32.0 GB / 64.0 GB" Foreground="#8ea0b0" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="#101d2a" BorderBrush="#1b2d48" BorderThickness="1" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="◧  GPU USAGE" FontWeight="Bold" FontSize="16"/><ProgressBar x:Name="ProgressGpu" Value="19" Maximum="100" Height="12" Foreground="#f5b729" Margin="0,14,0,0"/><TextBlock x:Name="LabelGpu" Text="NVIDIA / AMD Active Load" Foreground="#8ea0b0" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border Background="#101d2a" BorderBrush="#1b2d48" BorderThickness="1" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="📈  Realtime System Performance Graph" FontSize="22" FontWeight="Bold"/><Canvas Height="190" Background="#06111d" Margin="0,14,0,0"><Polyline Stroke="#1ee9ff" StrokeThickness="2" Points="0,140 80,100 160,150 240,80 320,120 400,60 480,110 560,90 640,130 720,70 800,110"/><Polyline Stroke="#ff5ac8" StrokeThickness="2" Points="0,120 80,140 160,90 240,120 320,70 400,130 480,80 560,120 640,90 720,140 800,100"/></Canvas></StackPanel></Border>
                    <TextBlock Text="Quick Access Shortcuts" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="4">
                        <Button Content="⚡  BOOST FIVEM" Height="80" Margin="0,0,8,0" Click="BtnBoost_Click"/>
                        <Button Content="🧹  JUNK CLEANER" Height="80" Margin="4,0" Click="BtnCleaning_Click"/>
                        <Button Content="⚙  STARTUP MANAGER" Height="80" Margin="4,0" Click="BtnStartup_Click"/>
                        <Button Content="ℹ  SYSTEM INFO" Height="80" Margin="8,0,0,0" Click="BtnSystemInfo_Click"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>