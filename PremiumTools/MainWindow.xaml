using System.Windows;

namespace PremiumTools;

public partial class ActivationWindow : Window
{
    private const string CorrectKey = "godego";

    public ActivationWindow()
    {
        InitializeComponent();
        KeyBox.Focus();
    }

    private void UnlockButton_Click(object sender, RoutedEventArgs e)
    {
        if (string.Equals(KeyBox.Password.Trim(), CorrectKey, StringComparison.OrdinalIgnoreCase))
        {
            var mainWindow = new MainWindow();
            mainWindow.Show();
            Close();
            return;
        }

        MessageBox.Show("Invalid activation key. Use: godego", "Premium Tools", MessageBoxButton.OK, MessageBoxImage.Warning);
        KeyBox.Clear();
        KeyBox.Focus();
    }

    private void CancelButton_Click(object sender, RoutedEventArgs e)
    {
        Application.Current.Shutdown();
    }
}
